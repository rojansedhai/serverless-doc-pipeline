# State files contain sensitive infrastructure details (account IDs, ARNs, keys)
terraform/.terraform/
terraform/.builds/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars
!terraform/terraform.tfvars.example

# =============================================================================
# Frontend
# =============================================================================
frontend/node_modules/
frontend/dist/

# =============================================================================
